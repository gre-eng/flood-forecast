# ---------- Raw third-party data (licence restrictions) ----------
# EM-DAT terms restrict redistribution, so keep the raw download out.
# Change these names to match the real files in your data/ folder.
data/emdat*
data/public_emdat*

# ---------- Large or regenerable files ----------
# Raw city list, only needed to build state_capitals.csv
data/ng.csv
